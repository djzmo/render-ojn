1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/src/app.ico"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS 0x4
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "DJZMO"
      VALUE "FileDescription", "OJN music renderer"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "RenderOJN"
      VALUE "LegalCopyright", "Copyright (C) 2012-2026 DJZMO"
      VALUE "OriginalFilename", "RenderOJN.exe"
      VALUE "ProductName", "RenderOJN"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
      VALUE "Comments", "GPL-3.0-only"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
